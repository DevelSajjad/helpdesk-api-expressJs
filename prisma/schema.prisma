// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Company {
  id  Int @id @default(autoincrement())
  name String 
  description String @db.Text

  users   User[]
  departments Department[]
  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        Int   @id @default(autoincrement())
  companyId Int?
  name      String  
  email     String   @unique
  password  String

  role     String    @default("CUSTOMER")

  company Company? @relation(fields: [companyId], references: [id])
  createdTickets Ticket[] @relation("CustomerTicket")
  assignedTickets Ticket[] @relation("AgentTicket")
  ticketReplies TicketReply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  AGENT
  CUSTOMER
}

model Department {
  id Int @id @default(autoincrement())
  companyId Int
  name String
  description String?

  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model Ticket {
  id Int @id @default(autoincrement())
  ticketNumber String? @unique
  subject String 
  description String 
  
  status TicketStatus @default(OPEN)
  priority TicketPriority @default(LOW)

  departmentId Int?
  companyId Int
  customerId Int?
  agentId Int?

  department Department? @relation(fields: [departmentId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])
  customer User? @relation("CustomerTicket", fields: [customerId], references: [id])
  agent User? @relation("AgentTicket", fields: [agentId], references: [id])

  replies TicketReply[]
  ticketAttachment TicketAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId, companyId, customerId, agentId])
  @@index([ticketNumber, status, priority])

}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
  ON_HOLD
  CANCELLED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

model TicketReply {
  id    Int   @id   @default(autoincrement())
  ticketId Int
  userId Int
  message String

  isInternal Boolean @default(false)

  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId, userId])
}

model TicketAttachment {
  id    Int   @id   @default(autoincrement())
  ticketId  Int
  fileName String
  originalName String?
  mimeType  String?
  fileSize Int?

  createdAt   DateTime  @default(now())

  ticket  Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}